<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="intro" aria-labelledby="journal-title">
    <div>
      <p class="eyebrow"><span class="status-square"></span> A LITTLE DAILY PRACTICE</p>
      <h1 id="journal-title">Good food.<br />Real <span class="highlight">life.</span></h1>
      <p class="intro-copy">A home for what’s on your plate.<br />Less tracking. More living.</p>
    </div>
    <div class="plate-illustration" aria-hidden="true">
      <span class="illustration-label">KEEP IT SIMPLE.</span>
      <svg viewBox="0 0 280 240" fill="none">
        <path
          d="M20 46v40m10-40v40m10-40v28q0 17-20 17V46m10 45v111M260 202V46q-26 22 0 65"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
        />
        <circle cx="148" cy="132" r="88" fill="currentColor" />
        <circle cx="141" cy="125" r="88" fill="#fffef9" stroke="currentColor" stroke-width="4" />
        <circle cx="141" cy="125" r="66" stroke="currentColor" stroke-width="2" />
        <path
          d="M91 128q-19-28 10-34q0-29 23-13q27-16 29 10q27 17 0 35q-2 29-27 14q-28 17-35-12Z"
          fill="#b7d96d"
          stroke="currentColor"
          stroke-width="3"
        />
        <path
          d="m102 131 31-33m-17 18-11-11m19 3 12 4"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
        />
        <ellipse
          cx="159"
          cy="147"
          rx="27"
          ry="33"
          transform="rotate(-25 159 147)"
          fill="#ffd570"
          stroke="currentColor"
          stroke-width="3"
        />
        <circle cx="158" cy="145" r="12" fill="#f39872" stroke="currentColor" stroke-width="3" />
        <path
          d="m222 24 4 12 12 4-12 4-4 12-4-12-12-4 12-4Z"
          fill="#edb5ce"
          stroke="currentColor"
          stroke-width="2"
        />
      </svg>
      <span class="illustration-note">one bite at a time.</span>
    </div>
  </section>

  <section class="upload-panel landing-invitation" aria-labelledby="welcome-title">
    <div class="upload-intro">
      <span class="icon-tile"><.icon name="hero-camera" class="size-7" /></span>
      <div>
        <h2 id="welcome-title">Your own little corner.</h2>
        <p>Good meals. Small moments. All yours.</p>
      </div>
    </div>
    <div>
      <.link
        navigate={
          if @current_scope,
            do: ~p"/app/profile/#{@current_scope.actor.nickname}",
            else: ~p"/users/register"
        }
        id="landing-profile"
        class="neo-button add-button"
      >
        {if @current_scope, do: "Your profile", else: "Start your journal"}
        <.icon name="hero-arrow-right" class="size-5" />
      </.link>
      <p class="upload-help">Your public food journal · Create an account to get started</p>
    </div>
  </section>

  <section class="welcome-features" aria-label="A simpler food journal">
    <article class="welcome-feature">
      <span class="feature-number">01</span>
      <.icon name="hero-photo" class="size-7" />
      <h2>Start with a photo.</h2>
      <p>Breakfast, a midnight snack, that really good sandwich. There’s room for it all.</p>
    </article>
    <article class="welcome-feature">
      <span class="feature-number">02</span>
      <.icon name="hero-squares-2x2" class="size-7" />
      <h2>See the everyday.</h2>
      <p>A quiet place for your food moments, one day at a time. No perfect plates required.</p>
    </article>
    <article class="welcome-feature">
      <span class="feature-number">03</span>
      <.icon name="hero-flag" class="size-7" />
      <h2>Make it yours.</h2>
      <p>Your own goals, at your own pace. A little daily practice, not another to-do list.</p>
    </article>
  </section>
  <footer class="journal-footer">
    <p><.icon name="hero-sparkles" class="size-4" /> Built for real life. A little every day.</p>
    <p>Your photos and personal targets. Saved for your next visit.</p>
  </footer>
</Layouts.app>
