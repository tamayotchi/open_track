<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  app_shell={not is_nil(@current_user)}
  active_tab={if @profile_owner?, do: :account, else: :profile}
>
  <%= if is_nil(@profile) do %>
    <section
      id="profile-not-found"
      class="mx-auto my-12 max-w-xl rounded-2xl border-2 border-black bg-white/60 p-8 text-center shadow-[5px_5px_0_0_#000] sm:my-20 sm:p-12"
      aria-labelledby="profile-not-found-title"
    >
      <span class="icon-tile mx-auto mb-6">
        <.icon name="hero-user-circle" class="size-9" />
      </span>
      <p class="eyebrow">A LITTLE LOST?</p>
      <h1 id="profile-not-found-title" class="mt-3 text-3xl font-bold">Profile not found</h1>
      <p class="mt-4 leading-relaxed">
        We couldn’t find a journal at this address. Check the nickname in the link and try again.
      </p>
      <.link
        id="profile-not-found-home"
        href={~p"/"}
        class="neo-button mt-8 transition-transform hover:-translate-y-0.5"
      >
        <.icon name="hero-arrow-left" class="size-4" /> Back to home
      </.link>
    </section>
  <% else %>
    <div class="public-journal">
      <section id="public-profile" class="profile-header" aria-labelledby="profile-name">
        <div class="profile-identity">
          <div class="profile-portrait">
            <img
              :if={@profile.avatar_url}
              id="profile-avatar"
              src={@profile.avatar_url}
              alt={"#{@profile.nickname}'s avatar"}
              width="112"
              height="112"
              class="account-avatar account-profile-avatar object-cover"
            />
            <span
              :if={!@profile.avatar_url}
              id="profile-avatar-placeholder"
              class="account-avatar account-profile-avatar"
            >
              <.icon name="hero-user" class="size-12" />
            </span>
            <dl class="profile-connections" aria-label="Profile connections">
              <div id="profile-followers">
                <dt>Followers</dt>
                <dd class="tabular-nums">{@profile.followers_count}</dd>
              </div>
              <div id="profile-following">
                <dt>Following</dt>
                <dd class="tabular-nums">{@profile.following_count}</dd>
              </div>
            </dl>
          </div>
          <div class="profile-heading">
            <p class="eyebrow"><span class="status-square"></span> FOOD JOURNAL</p>
            <h1 id="profile-name">{@profile.nickname}</h1>
            <div class="profile-actions">
              <button
                :if={@current_user && !@profile_owner?}
                id="profile-follow-button"
                type="button"
                phx-click={if @following?, do: "unfollow", else: "follow"}
                phx-disable-with="Updating…"
                class={["neo-button small-button", !@following? && "button-primary"]}
              >
                <.icon
                  name={if @following?, do: "hero-user-minus", else: "hero-user-plus"}
                  class="size-4"
                />
                {if @following?, do: "Unfollow", else: "Follow"}
              </button>
              <.link
                :if={!@current_user}
                id="profile-follow-login"
                href={~p"/users/log-in"}
                class="neo-button small-button button-primary"
              >
                <.icon name="hero-user-plus" class="size-4" /> Log in to follow
              </.link>
              <.link
                :if={@profile_owner?}
                id="profile-settings-link"
                navigate={~p"/app/account/settings"}
                class="neo-button small-button"
              >
                <.icon name="hero-cog-6-tooth" class="size-4" /> Settings
              </.link>
            </div>
          </div>
        </div>
        <NutritionComponents.objectives settings={@settings} editable={@profile_owner?} />
      </section>

      <details
        id={"profile-insights-#{@profile.id}"}
        class="profile-insights"
        phx-mounted={JS.ignore_attributes("open")}
      >
        <summary id="profile-insights-toggle" class="profile-insights-toggle">
          <span class="insights-icon"><.icon name="hero-chart-bar" class="size-6" /></span>
          <span class="insights-title">Nutrition & trends</span>
          <span class="insights-action" aria-hidden="true">
            <span class="insights-closed-label">View metrics</span>
            <span class="insights-open-label">Hide metrics</span>
          </span>
          <.icon name="hero-chevron-down" class="insights-chevron size-5 shrink-0" />
        </summary>
        <section class="nutrition-history" aria-labelledby="nutrition-title">
          <div class="section-heading">
            <h2 id="nutrition-title">The bigger picture.</h2>
            <.form for={%{}} id="chart-range" phx-change="range">
              <.input
                type="select"
                name="days"
                value={@days}
                label="Date range"
                options={[{"7 days", 7}, {"30 days", 30}, {"90 days", 90}]}
              />
            </.form>
          </div>
          <p id="nutrition-timezone" class="section-description">
            Calories and protein are AI estimates summed by upload date in {@timezone_label},
            not measured intake. Missing days stay blank. Other measurements are not connected.
            <.link
              :if={@profile_owner?}
              navigate={~p"/app/account/settings#timezone-preferences"}
              class="text-link"
            >
              Change timezone
            </.link>
          </p>
          <div class="nutrition-grid">
            <NutritionComponents.chart
              :for={metric <- NutritionChart.metrics()}
              metric={metric}
              entries={@entries}
              days={@days}
              today={@today}
              timezone_label={@timezone_label}
            />
          </div>
        </section>
      </details>

      <section class="journal-section" aria-labelledby="photos-title">
        <div class="section-heading">
          <div class="section-title">
            <h2 id="photos-title">
              {if @profile_owner?, do: "Your food journal", else: "Food journal"}
            </h2>
            <span id="photo-count" class="count-badge">{@photo_count}</span>
          </div>
          <span class="sort-note">
            <.icon name="hero-bars-arrow-down" class="size-4" /> Newest first
          </span>
        </div>
        <div class="journal-toolbar">
          <p id="journal-timezone">Everyday moments · Upload dates in {@timezone_label}</p>
          <div class="journal-view-switch" role="group" aria-label="Food journal view">
            <button
              type="button"
              id="view-cards"
              phx-click="set-view"
              phx-value-mode="cards"
              aria-pressed={to_string(@view_mode == :cards)}
            >
              <.icon name="hero-squares-2x2" class="size-4" /> Cards
            </button>
            <button
              type="button"
              id="view-table"
              phx-click="set-view"
              phx-value-mode="table"
              aria-pressed={to_string(@view_mode == :table)}
            >
              <.icon name="hero-table-cells" class="size-4" /> Table
            </button>
          </div>
        </div>
        <div id="photos" phx-update="stream" class="photo-grid" hidden={@view_mode != :cards}>
          <div id="empty-journal" class="empty-journal hidden only:flex">
            <span class="empty-icon">
              <.icon name="hero-photo" class="size-9" /><span class="little-plus">+</span>
            </span>
            <h3>
              {if @profile_owner?, do: "Your first bite goes here.", else: "No food moments yet."}
            </h3>
            <p :if={@profile_owner?}>
              Breakfast, a midnight snack, that really good sandwich.<br />Start with a photo. Make it yours.
            </p>
            <.link :if={@profile_owner?} navigate={~p"/app/add"} class="empty-hint">
              <.icon name="hero-plus" class="size-4" /> Add your first photo
            </.link>
          </div>
          <FoodComponents.photo_card
            :for={{id, photo} <- @streams.photos}
            id={id}
            photo={photo}
            timezone={@timezone}
            editable={@profile_owner?}
          />
        </div>
        <div id="food-log-panel" class="food-log-panel" hidden={@view_mode != :table}>
          <div class="table-scroll" tabindex="0" role="region" aria-label="Food journal table">
            <table class="food-log-table">
              <caption class="sr-only">Food journal. Upload dates in {@timezone_label}.</caption>
              <thead>
                <tr>
                  <th scope="col">Photo</th>
                  <th scope="col">Uploaded ({@timezone_label})</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody id="food-log-rows" phx-update="stream">
                <tr id="empty-food-log" class="hidden only:table-row">
                  <td colspan="3">No food photos yet.</td>
                </tr>
                <FoodComponents.food_log_row
                  :for={{id, photo} <- @streams.food_log}
                  id={id}
                  photo={photo}
                  timezone={@timezone}
                  editable={@profile_owner?}
                />
              </tbody>
            </table>
          </div>
        </div>
      </section>
      <button
        :if={@more?}
        type="button"
        id="load-more"
        phx-click="load-more"
        class="neo-button"
        phx-disable-with="Loading…"
      >
        Load more photos
      </button>
      <p class="member-footer">
        <.icon name="hero-sparkles" class="size-4" /> A little daily practice. One bite at a time.
      </p>
    </div>
  <% end %>
</Layouts.app>
