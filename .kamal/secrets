# Safe to commit: 1Password references only, never plaintext credentials.
# Reuse tama_track's existing item; no sibling checkout is required at deploy time.
SECRETS=$(kamal secrets fetch --adapter 1password --account instaleap-llc.1password.com --from SERVER/TAMA_TRACK KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY FOOD_AI_API_KEY)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
R2_ACCOUNT_ID=$(kamal secrets extract R2_ACCOUNT_ID $SECRETS)
R2_ACCESS_KEY_ID=$(kamal secrets extract R2_ACCESS_KEY_ID $SECRETS)
R2_SECRET_ACCESS_KEY=$(kamal secrets extract R2_SECRET_ACCESS_KEY $SECRETS)
FOOD_AI_API_KEY=$(kamal secrets extract FOOD_AI_API_KEY $SECRETS)
